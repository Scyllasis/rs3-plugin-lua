{
  "name": "rs3-plugin-lua",
  "displayName": "RS3 Plugin API (Lua)",
  "description": "Autocomplete, hover docs, a drag-and-drop UI builder for PrettyUI and plain UI, a live UI preview, deploy to the game, a plugin data and log viewer, plugin checks, a sprite maker and a style studio for RuneScape 3 Plugin Hub Lua plugins.",
  "version": "0.8.0",
  "publisher": "sam-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scyllasis/rs3-plugin-lua"
  },
  "bugs": {
    "url": "https://github.com/Scyllasis/rs3-plugin-lua/issues"
  },
  "homepage": "https://github.com/Scyllasis/rs3-plugin-lua#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "runescape",
    "rs3",
    "lua",
    "plugin",
    "jagex"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "extensionPack": [
    "sumneko.lua"
  ],
  "activationEvents": [
    "onLanguage:lua",
    "workspaceContains:**/plugin.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rs3lua.enable",
        "title": "RS3: Enable Plugin API for This Workspace",
        "category": "RS3"
      },
      {
        "command": "rs3lua.disable",
        "title": "RS3: Disable Plugin API for This Workspace",
        "category": "RS3"
      },
      {
        "command": "rs3lua.newPlugin",
        "title": "RS3: New Plugin…",
        "category": "RS3"
      },
      {
        "command": "rs3lua.openDocs",
        "title": "Open API Docs",
        "category": "RS3",
        "icon": "$(book)"
      },
      {
        "command": "rs3lua.docsForSymbol",
        "title": "RS3: Open Docs for Symbol Under Cursor",
        "category": "RS3"
      },
      {
        "command": "rs3lua.searchApi",
        "title": "Search API…",
        "category": "RS3",
        "icon": "$(search)"
      },
      {
        "command": "rs3lua.explorer.insert",
        "title": "Insert at Cursor",
        "icon": "$(insert)"
      },
      {
        "command": "rs3lua.explorer.openDocs",
        "title": "Open Docs",
        "icon": "$(link-external)"
      },
      {
        "command": "rs3lua.explorer.copy",
        "title": "Copy Name",
        "icon": "$(copy)"
      },
      {
        "command": "rs3lua.cheats",
        "title": "Copy a Cheat or Console Command…",
        "category": "RS3",
        "icon": "$(terminal)"
      },
      {
        "command": "rs3lua.preview",
        "title": "Open UI Preview",
        "category": "RS3",
        "icon": "$(open-preview)"
      },
      {
        "command": "rs3lua.newSprite",
        "title": "New Sprite…",
        "category": "RS3",
        "icon": "$(paintcan)"
      },
      {
        "command": "rs3lua.editSprite",
        "title": "RS3: Edit in Sprite Maker",
        "category": "RS3",
        "icon": "$(edit)"
      },
      {
        "command": "rs3lua.styleStudio",
        "title": "Open Style Studio",
        "category": "RS3",
        "icon": "$(symbol-color)"
      },
      {
        "command": "rs3lua.checkSetup",
        "title": "Check Setup (fix missing completions)",
        "category": "RS3",
        "icon": "$(pulse)"
      },
      {
        "command": "rs3lua.findItem",
        "title": "Find Item…",
        "category": "RS3",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "rs3lua.catalog.updateWiki",
        "title": "RS3: Update Item List from the RS Wiki",
        "category": "RS3"
      },
      {
        "command": "rs3lua.catalog.createExport",
        "title": "RS3: Create Item Export Plugin (your bank/backpack/worn items)",
        "category": "RS3"
      },
      {
        "command": "rs3lua.catalog.import",
        "title": "RS3: Import Item Export Output (console text)",
        "icon": "$(clippy)"
      },
      {
        "command": "rs3lua.catalog.clear",
        "title": "RS3: Clear Item List",
        "category": "RS3"
      },
      {
        "command": "rs3lua.uiBuilder",
        "title": "Open UI Builder",
        "category": "RS3",
        "icon": "$(layout)"
      },
      {
        "command": "rs3lua.deploy",
        "title": "Deploy to Game",
        "category": "RS3",
        "icon": "$(rocket)"
      },
      {
        "command": "rs3lua.checkPlugin",
        "title": "Check Plugin",
        "category": "RS3",
        "icon": "$(checklist)"
      },
      {
        "command": "rs3lua.package",
        "title": "Package for Upload",
        "category": "RS3",
        "icon": "$(package)"
      },
      {
        "command": "rs3lua.submissionChecklist",
        "title": "Open Upload Checklist",
        "category": "RS3",
        "icon": "$(checklist)"
      },
      {
        "command": "rs3lua.pluginData",
        "title": "Open Plugin Data",
        "category": "RS3",
        "icon": "$(database)"
      },
      {
        "command": "rs3lua.addLogCapture",
        "title": "Add Log Capture",
        "category": "RS3",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rs3lua",
          "title": "RS3 Plugin API",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "rs3lua": [
        {
          "id": "rs3lua.explorer",
          "name": "API Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rs3lua.searchApi",
          "when": "view == rs3lua.explorer",
          "group": "navigation@1"
        },
        {
          "command": "rs3lua.preview",
          "when": "view == rs3lua.explorer",
          "group": "navigation@2"
        },
        {
          "command": "rs3lua.deploy",
          "when": "view == rs3lua.explorer",
          "group": "navigation@3"
        },
        {
          "command": "rs3lua.uiBuilder",
          "when": "view == rs3lua.explorer",
          "group": "1_build@1"
        },
        {
          "command": "rs3lua.newSprite",
          "when": "view == rs3lua.explorer",
          "group": "1_build@2"
        },
        {
          "command": "rs3lua.styleStudio",
          "when": "view == rs3lua.explorer",
          "group": "1_build@3"
        },
        {
          "command": "rs3lua.checkPlugin",
          "when": "view == rs3lua.explorer",
          "group": "2_test@1"
        },
        {
          "command": "rs3lua.pluginData",
          "when": "view == rs3lua.explorer",
          "group": "2_test@2"
        },
        {
          "command": "rs3lua.addLogCapture",
          "when": "view == rs3lua.explorer",
          "group": "2_test@3"
        },
        {
          "command": "rs3lua.cheats",
          "when": "view == rs3lua.explorer",
          "group": "2_test@4"
        },
        {
          "command": "rs3lua.package",
          "when": "view == rs3lua.explorer",
          "group": "3_upload@1"
        },
        {
          "command": "rs3lua.submissionChecklist",
          "when": "view == rs3lua.explorer",
          "group": "3_upload@2"
        },
        {
          "command": "rs3lua.findItem",
          "when": "view == rs3lua.explorer",
          "group": "4_reference@1"
        },
        {
          "command": "rs3lua.openDocs",
          "when": "view == rs3lua.explorer",
          "group": "4_reference@2"
        },
        {
          "command": "rs3lua.checkSetup",
          "when": "view == rs3lua.explorer",
          "group": "4_reference@3"
        }
      ],
      "view/item/context": [
        {
          "command": "rs3lua.explorer.insert",
          "when": "view == rs3lua.explorer && viewItem =~ /insertable/",
          "group": "inline"
        },
        {
          "command": "rs3lua.explorer.openDocs",
          "when": "view == rs3lua.explorer && viewItem =~ /docs/",
          "group": "inline"
        },
        {
          "command": "rs3lua.explorer.copy",
          "when": "view == rs3lua.explorer && viewItem =~ /insertable/"
        }
      ],
      "editor/context": [
        {
          "command": "rs3lua.docsForSymbol",
          "when": "editorLangId == lua",
          "group": "navigation@90"
        },
        {
          "command": "rs3lua.findItem",
          "when": "editorLangId == lua",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "rs3lua.explorer.insert",
          "when": "false"
        },
        {
          "command": "rs3lua.explorer.openDocs",
          "when": "false"
        },
        {
          "command": "rs3lua.explorer.copy",
          "when": "false"
        },
        {
          "command": "rs3lua.editSprite",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "rs3lua.preview",
          "when": "resourceLangId == lua || resourceFilename == plugin.json",
          "group": "navigation"
        },
        {
          "command": "rs3lua.editSprite",
          "when": "resourceExtname == .png",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "rs3lua.preview",
          "when": "resourceFilename == plugin.json || resourceFilename == main.lua",
          "group": "navigation@90"
        },
        {
          "command": "rs3lua.editSprite",
          "when": "resourceExtname == .png",
          "group": "navigation@91"
        },
        {
          "command": "rs3lua.newSprite",
          "when": "explorerResourceIsFolder && resourceFilename == resources || explorerResourceIsFolder && resourcePath =~ /[\\\\/]resources[\\\\/]/",
          "group": "navigation@92"
        },
        {
          "command": "rs3lua.uiBuilder",
          "when": "resourcePath =~ /[\\\\/]\\.rs3[\\\\/]ui[\\\\/][^\\\\/]+\\.json$/",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/rs3.code-snippets"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "plugin.json",
          "!**/.claude-plugin/plugin.json",
          "!**/node_modules/**"
        ],
        "url": "./schemas/plugin.schema.json"
      }
    ],
    "configuration": {
      "title": "RS3 Plugin API",
      "properties": {
        "rs3lua.autoEnable": {
          "type": "string",
          "enum": [
            "whenPluginJson",
            "always",
            "never"
          ],
          "default": "whenPluginJson",
          "markdownDescription": "When to add the RS3 API definitions to the Lua language server for a workspace. `whenPluginJson` turns it on for any workspace containing a `plugin.json`."
        },
        "rs3lua.docsBaseUrl": {
          "type": "string",
          "default": "https://developer.runescape.com/rs/",
          "description": "Base URL of the official RuneScape Client API documentation."
        },
        "rs3lua.preview.resolution": {
          "type": "string",
          "default": "1920x1080",
          "enum": [
            "1280x720",
            "1366x768",
            "1600x900",
            "1920x1080",
            "2560x1440",
            "3440x1440",
            "3840x2160"
          ],
          "description": "Default client resolution for the UI preview."
        },
        "rs3lua.preview.uiScale": {
          "type": "number",
          "default": 1,
          "enum": [
            0.75,
            1,
            1.25,
            1.5,
            2
          ],
          "description": "Default interface scaling for the UI preview (interface units = pixels / scale)."
        },
        "rs3lua.preview.contentWindowSize": {
          "type": "string",
          "default": "420x560",
          "pattern": "^\\d+\\s*x\\s*\\d+$",
          "markdownDescription": "Size (interface units, `WIDTHxHEIGHT`) the preview uses for the plugin window opened from the ribbon icon (`Event.ContentLayerReady`). The docs don't state the real size; match it to what you see in-game."
        },
        "rs3lua.preview.settingsWindowSize": {
          "type": "string",
          "default": "520x420",
          "pattern": "^\\d+\\s*x\\s*\\d+$",
          "markdownDescription": "Size the preview uses for the plugin settings window (`Event.SettingsLayerReady`)."
        },
        "rs3lua.itemExport.port": {
          "type": "number",
          "default": 47321,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "Local port the item export plugin sends your items to (`http://127.0.0.1:<port>`). Create the export plugin again after changing it."
        },
        "rs3lua.devPluginsFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "The game client's `dev_plugins` folder. Leave empty to find it automatically (`%ProgramData%\\Jagex\\RuneScape-BETA\\dev_plugins` or `RuneScape\\dev_plugins`)."
        },
        "rs3lua.check.onSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run **RS3: Check Plugin** when a plugin's Lua or JSON file is saved. Results go to the Problems panel."
        },
        "rs3lua.deploy.onSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Copy a plugin into the client's `dev_plugins` folder whenever one of its files is saved. Applies only to plugins you've already deployed once with **RS3: Deploy to Game**."
        }
      }
    },
    "keybindings": [
      {
        "command": "rs3lua.findItem",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorLangId == lua"
      }
    ],
    "walkthroughs": [
      {
        "id": "rs3lua.start",
        "title": "Make your first RS3 plugin",
        "description": "From an empty folder to your plugin running in the game.",
        "steps": [
          {
            "id": "new",
            "title": "Create a plugin",
            "description": "Pick a folder, then start from a template.\n[New Plugin](command:rs3lua.newPlugin)",
            "media": {
              "markdown": "walkthrough/new.md"
            },
            "completionEvents": [
              "onCommand:rs3lua.newPlugin"
            ]
          },
          {
            "id": "build",
            "title": "Draw your UI",
            "description": "Drag buttons, text and more onto a window, and the Lua is written for you.\n[Open UI Builder](command:rs3lua.uiBuilder)",
            "media": {
              "markdown": "walkthrough/build.md"
            },
            "completionEvents": [
              "onCommand:rs3lua.uiBuilder"
            ]
          },
          {
            "id": "preview",
            "title": "See it without the game",
            "description": "Your real code runs against a simulated client.\n[Open UI Preview](command:rs3lua.preview)",
            "media": {
              "markdown": "walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:rs3lua.preview"
            ]
          },
          {
            "id": "deploy",
            "title": "Run it in the game",
            "description": "Copies the plugin into the client and the console commands to your clipboard.\n[Deploy to Game](command:rs3lua.deploy)",
            "media": {
              "markdown": "walkthrough/deploy.md"
            },
            "completionEvents": [
              "onCommand:rs3lua.deploy"
            ]
          },
          {
            "id": "ship",
            "title": "Get it ready to upload",
            "description": "Check it against the client's and Jagex's rules, then build the zip.\n[Check Plugin](command:rs3lua.checkPlugin)",
            "media": {
              "markdown": "walkthrough/ship.md"
            },
            "completionEvents": [
              "onCommand:rs3lua.checkPlugin"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build:index": "node tools/build-index.js",
    "package": "npm run build:index && npx --yes @vscode/vsce@3.6.0 package --no-dependencies",
    "test": "node --test test/builder.test.js test/tools.test.js test/panel.test.js test/data.test.js",
    "test:browser": "node test/browser/builder.browser.js && node test/browser/data.browser.js",
    "test:smoke": "node test/smoke/run.js"
  },
  "dependencies": {
    "wasmoon": "^1.16.0"
  }
}
